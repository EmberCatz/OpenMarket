-- Market Sync
--
-- The in-game half of OpenMarket. The Node backend (../server/) has no
-- live game session, so it can't talk to SpaceNinjaServer directly - this
-- script is the only piece with owf_get_auth_query() session auth, so
-- it's the only piece allowed to touch SpaceNinjaServer. It polls the
-- backend for queued buy/sell orders placed from the browser UI, executes
-- them against SpaceNinjaServer, and reports the result back.
--
-- SETUP: run `npm install && npm start` in ../server first (defaults to
-- http://127.0.0.1:7890), then load this script in-game and start it
-- (autostarting it alongside your other scripts works fine - it does
-- nothing but poll harmlessly if the backend isn't reachable yet).
--
-- CONFIRMED WORKING end-to-end in-game (2026-09-17): buy and sell round
-- trips (item granted/removed, platinum debited/credited) verified
-- through the real web UI for Mods, Arcanes, and Relics; Prime Warframe
-- parts/sets (category "Recipes") separately confirmed via "Market Prime
-- Recipe Probe.pluto" the same day - not just in isolation.
--
-- Scope: Mods + Arcanes (category "Upgrades"), Relics (category
-- "MiscItems"), and Prime Warframe parts/sets (category "Recipes"). All
-- three operate purely on the item's ItemType path - confirmed from
-- SpaceNinjaServer's actual source (its sellController.ts's Upgrades/
-- MiscItems/Recipes branches all accept an entry {String=<path>,
-- Count=N>0} that decrements N stacked copies by path, the same shape its
-- addItems accepts to grant them) - no oid/inventory.php lookup needed,
-- unlike unique-instance gear (Suits, weapons, etc), which would need a
-- specific owned copy's real database id instead of a bare type path. The
-- backend tells us which Items.<category> key to use per order
-- (order.category).
--
-- Lifecycle: fire-and-forget polling loop (`repeat ... until yield()`) -
-- no persistent client-side state is ever set, so there's nothing to
-- revert if the script is stopped; an order left "processing" because the
-- script stopped mid-flight just times out on the backend side
-- (orderQueue.ts's STALE_PROCESSING_MS) instead of needing cleanup here.
-- Paced via os.millis() to poll only every POLL_MS, not every frame -
-- http.request is a synchronous/blocking call, so polling every frame
-- would needlessly stutter the game.
--
-- Rank (mod/arcane fusion level): order.rank > 0 on a BUY passes
-- Fingerprint={"lvl":N} to addItems, granting that exact rank instead of
-- a plain unranked copy - the same mechanism SpaceNinjaServer's own WebUI
-- uses for its "acquire mod max" flow (confirmed from source, not
-- invented here). A ranked grant lands in the unique-instance Upgrades
-- collection (not RawUpgrades) - selling a specific ranked copy needs its
-- real database id, which order.sellOid carries when present (see the
-- ranked-copy breakdown section below); doSell() branches on that rather
-- than order.rank.
--
-- Prime sets: order.parts (buy-only) is a list of {gameRef, category}
-- member items - a set's own gameRef is never granted (it's the finished
-- Warframe's own type path, a unique-instance route via addPowerSuit(),
-- deliberately avoided). Instead "Buy Full Set" grants every real
-- tradeable part individually in one loop, then does a single currency
-- debit for the whole bundle's price. No rollback on partial failure -
-- matches this script's existing best-effort pattern (nothing else here
-- rolls back either) - the player keeps whatever succeeded and is told
-- what didn't.
--
-- Owned-count sync: separately from order polling, this script also
-- fetches GET /api/inventory.php on its own INVENTORY_POLL_MS timer and
-- POSTs a flattened {ItemType: count} map (from the response's
-- RawUpgrades/MiscItems/Recipes arrays) to the backend, so the shop UI
-- can show what you actually own and gray out Sell at 0 - purely a UX
-- aid, not safety-critical (SpaceNinjaServer's own sellController.ts
-- already throws if a sell would take a count negative, confirmed from
-- source). CONFIRMED WORKING but with a real, MEASURED flakiness rate:
-- this endpoint returns "Connection Closed Prematurely" on roughly 25-30%
-- of calls on at least one real setup - quantified with a dedicated
-- 15-sample probe (see scripts/Market Inventory Flake Probe.pluto), which
-- also showed the response is a constant, small size (~300KB, ~60ms) each
-- time - ruling out payload size/timeout as the cause. A failed fetch
-- here just skips that cycle and retries next time, which at that flake
-- rate gets a successful sync within 1-2 cycles the large majority of the
-- time.
--
-- Ranked-copy breakdown + sell-by-oid, CONFIRMED WORKING (2026-09-17).
-- The same inventory.php read also parses the response's "Upgrades"
-- array (unique-instance ranked mod/arcane copies, separate from the
-- plain-stack RawUpgrades above) and reports each instance's rank + real
-- database id (oid) to the backend - so owning e.g. a rank 0, rank 3, and
-- max-rank copy of the same mod at once shows as 3 distinct lines instead
-- of one ambiguous count. The "Fingerprint" field this script sends on a
-- ranked grant is stored server-side as "UpgradeFingerprint" on that
-- Upgrades entry (same {"lvl":N} shape) - confirmed from source, and
-- selling a SPECIFIC instance by its oid (a String with no "/" in it)
-- takes a completely different sell.php code path
-- (`inventory.Upgrades.pull({_id: String})`) than the plain path+count
-- decrement every other sell here uses. Verified live with
-- "Market Ranked Sell Probe.pluto": granted a rank-3 Serration, found its
-- exact oid via UpgradeFingerprint, sold it BY OID, then confirmed the
-- Upgrades entry count dropped by exactly 1 (not just "something
-- changed").

local { http, json } = require "pluto:*"

local BACKEND_HOST = "127.0.0.1"
local BACKEND_PORT = 7890 -- must match the backend's MARKET_EMULATOR_PORT (default 7890)
local POLL_MS = 2000
local INVENTORY_POLL_MS = 30000 -- interval AFTER A SUCCESS - inventory.php is a heavy ~300KB call, not worth fetching every POLL_MS
local INVENTORY_RETRY_MS = 5000 -- interval AFTER A FAILURE - short, since the flake rate below is quick/random, not a sustained outage - waiting a full 30s after every failure meant a bad run of luck could leave "Owned: ?" stuck for minutes

local function backendUrl(path)
    return "http://" .. BACKEND_HOST .. ":" .. tostring(BACKEND_PORT) .. path
end

local function snsUrl(path, extraParams)
    local url = "http://" .. owf_get_server_host() .. ":" .. owf_get_http_port() .. path .. "?" .. owf_get_auth_query()
    if extraParams then
        url = url .. "&" .. extraParams
    end
    return url
end

local function fetchPendingOrder()
    local ok, body, status = pcall(function()
        return http.request(backendUrl("/internal/pending-order"), {
            method = "GET",
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
    if not ok or status ~= 200 then
        return nil -- covers both "204 nothing queued" and "backend unreachable"
    end
    local decodeOk, order = pcall(json.decode, body)
    if not decodeOk then
        return nil
    end
    return order
end

local function reportResult(orderId, wasOk, detail)
    pcall(function()
        return http.request(backendUrl("/internal/order-result"), {
            method = "POST",
            headers = { ["Content-Type"] = "application/json" },
            body = json.encode({ orderId = orderId, ok = wasOk, detail = detail }),
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
end

-- Flattens inventory.php's per-category arrays ({ItemType, ItemCount}[])
-- into one {ItemType: totalCount} map. Only the 3 categories this shop
-- actually sells from are relevant - RawUpgrades (rank-0 mods/arcanes,
-- the only rank Sell ever targets), MiscItems (relics, any refinement -
-- each refinement is already a distinct ItemType path), and Recipes
-- (Prime parts).
local function flattenOwnedCounts(inv)
    local counts = {}
    local function accumulate(list)
        if not list then return end
        for _, entry in list do
            counts[entry.ItemType] = (counts[entry.ItemType] or 0) + (entry.ItemCount or 0)
        end
    end
    accumulate(inv.RawUpgrades)
    accumulate(inv.MiscItems)
    accumulate(inv.Recipes)
    return counts
end

-- Parses inv.Upgrades (ranked/unique-instance mod+arcane copies) into
-- {ItemType: {rank, oid}[]} - the inverse of what doBuy() writes via
-- Fingerprint={"lvl":N} on the grant (stored server-side as
-- UpgradeFingerprint, same shape). ItemId is a Mongo-style oid wrapper
-- ({"$oid": "..."} or the legacy {"$id": "..."}), not a bare string.
-- Entries this script can't make sense of (no ItemId at all) are skipped
-- rather than guessed at - better to under-report than sell the wrong
-- thing later.
local function extractRankedInstances(inv)
    local result = {}
    if inv.Upgrades then
        for _, entry in inv.Upgrades do
            local oid = nil
            if entry.ItemId then
                oid = entry.ItemId["$oid"] or entry.ItemId["$id"]
            end
            if oid then
                local rank = 0
                if entry.UpgradeFingerprint then
                    local decodeOk, fingerprint = pcall(json.decode, entry.UpgradeFingerprint)
                    if decodeOk and fingerprint.lvl then
                        rank = fingerprint.lvl
                    end
                end
                if not result[entry.ItemType] then
                    result[entry.ItemType] = {}
                end
                table.insert(result[entry.ItemType], { rank = rank, oid = oid })
            end
        end
    end
    return result
end

-- Returns true/false so the caller can retry soon after a failure instead
-- of waiting a full INVENTORY_POLL_MS.
local waitingForLoginLogged = false

-- Before the game has logged in, owf_get_auth_query() has no accountId/
-- nonce to give (confirmed 2026-09-28 from a real SpaceNinjaServer log:
-- the request went out as "/api/inventory.php?&wsid=0" and SNS answered
-- 500 "Request is missing accountId parameter"). Wait quietly instead of
-- sending doomed requests every INVENTORY_RETRY_MS - log once, not per try.
local function syncInventorySnapshot()
    local authQuery = owf_get_auth_query()
    if authQuery == nil or authQuery == "" then
        if not waitingForLoginLogged then
            print("Market Sync: not logged in yet, waiting before fetching inventory")
            waitingForLoginLogged = true
        end
        return false
    end
    waitingForLoginLogged = false

    local ok, body, status = pcall(function()
        return http.request(snsUrl("/api/inventory.php", "wsid=0"), {
            method = "GET",
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
    if not (ok and status == 200) then
        print("Market Sync: inventory fetch failed (status=" .. tostring(status) .. "), retrying in " .. (INVENTORY_RETRY_MS / 1000) .. "s")
        return false
    end

    local decodeOk, inv = pcall(json.decode, body)
    if not decodeOk then
        print("Market Sync: inventory response failed to decode, retrying in " .. (INVENTORY_RETRY_MS / 1000) .. "s")
        return false
    end

    local postOk, postErr, postStatus = pcall(function()
        return http.request(backendUrl("/internal/inventory-snapshot"), {
            method = "POST",
            headers = { ["Content-Type"] = "application/json" },
            body = json.encode({ counts = flattenOwnedCounts(inv), ranked = extractRankedInstances(inv) }),
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
    if not postOk then
        print("Market Sync: failed to report inventory snapshot to backend - " .. tostring(postErr))
        return false
    end
    if tonumber(postStatus) == nil or tonumber(postStatus) >= 400 then
        print("Market Sync: backend rejected inventory snapshot (status=" .. tostring(postStatus) .. "), retrying in " .. (INVENTORY_RETRY_MS / 1000) .. "s")
        return false
    end
    return true
end

-- Single addItems call, shared by both the plain single-item buy path and
-- the Prime-set multi-part loop below.
local function grantSingleItem(itemType, fingerprint)
    local grantItem = { ItemType = itemType, ItemCount = 1 }
    if fingerprint then
        grantItem.Fingerprint = fingerprint
    end
    local ok, body, status = pcall(function()
        return http.request(snsUrl("/custom/addItems", "wsid=0"), {
            method = "POST",
            headers = { ["Content-Type"] = "application/json" },
            body = json.encode({ grantItem }),
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
    return ok and status == 200, body, status
end

-- Grant the item(s), then debit platinum only if every grant actually
-- succeeded (a failed grant should never cost the player anything).
local function doBuy(order)
    if order.parts and #order.parts > 0 then
        local partsGranted = 0
        local totalParts = #order.parts
        for _, part in order.parts do
            local ok, body, status = grantSingleItem(part.gameRef)
            if not ok then
                return false,
                    "set part " .. (partsGranted + 1) .. "/" .. totalParts .. " (" .. tostring(part.gameRef) ..
                    ") grant failed (status=" .. tostring(status) .. "): " .. tostring(body):sub(1, 150)
            end
            partsGranted = partsGranted + 1
        end
    else
        local fingerprint = nil
        if order.rank and order.rank > 0 then
            fingerprint = json.encode({ lvl = order.rank })
        end
        local ok, body, status = grantSingleItem(order.gameRef, fingerprint)
        if not ok then
            return false, "item grant failed (status=" .. tostring(status) .. "): " .. tostring(body):sub(1, 150)
        end
    end

    local payOk, payBody, payStatus = pcall(function()
        return http.request(snsUrl("/custom/addCurrency", "wsid=0"), {
            method = "POST",
            headers = { ["Content-Type"] = "application/json" },
            body = json.encode({ currency = "PremiumCredits", delta = -order.price }),
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
    if not (payOk and payStatus == 200) then
        return false, "item granted but platinum debit failed (status=" .. tostring(payStatus) .. "): " .. tostring(payBody):sub(1, 150) .. " - inventory and balance may be out of sync, check manually"
    end

    chat_system_reply("Market: bought " .. order.name .. " for " .. order.price .. " :platinum:")
    return true, nil
end

-- Remove the item (SellPrice=0 -> no real-currency side effect, matches
-- SpaceNinjaServer's own WebUI "bin icon" behavior), then credit platinum
-- only if the removal actually succeeded.
--
-- order.sellOid (a specific RANKED copy only) sells by bare database id
-- instead of ItemType path+count - sell.php's Upgrades branch treats a
-- String with no "/" in it as an oid and deletes that exact instance
-- (`inventory.Upgrades.pull({_id: String})`), confirmed from
-- sellController.ts. Otherwise order.category picks which Items.<key>
-- SpaceNinjaServer expects for the plain path+count sell ("Upgrades" for
-- rank-0 mods/arcanes, "MiscItems" for relics, "Recipes" for Prime parts)
-- - all three decrement by ItemType path the same way, only the wrapping
-- key differs.
local function doSell(order)
    local sellPayload
    if order.sellOid then
        sellPayload = {
            SellCurrency = "SC_RegularCredits",
            SellPrice = 0,
            Items = { Upgrades = { { String = order.sellOid, Count = 1 } } },
        }
    else
        local items = {}
        items[order.category] = { { String = order.gameRef, Count = 1 } }
        sellPayload = {
            SellCurrency = "SC_RegularCredits",
            SellPrice = 0,
            Items = items,
        }
    end

    local sellOk, sellBody, sellStatus = pcall(function()
        return http.request(snsUrl("/api/sell.php", "wsid=0"), {
            method = "POST",
            headers = { ["Content-Type"] = "text/plain" }, -- NOT application/json - see Market Sell Probe.pluto's header note for why
            body = json.encode(sellPayload),
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
    if not (sellOk and sellStatus == 200) then
        return false, "item removal failed (status=" .. tostring(sellStatus) .. "): " .. tostring(sellBody):sub(1, 150)
    end

    local payOk, payBody, payStatus = pcall(function()
        return http.request(snsUrl("/custom/addCurrency", "wsid=0"), {
            method = "POST",
            headers = { ["Content-Type"] = "application/json" },
            body = json.encode({ currency = "PremiumCredits", delta = order.price }),
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
    if not (payOk and payStatus == 200) then
        return false, "item removed but platinum credit failed (status=" .. tostring(payStatus) .. "): " .. tostring(payBody):sub(1, 150) .. " - inventory and balance may be out of sync, check manually"
    end

    chat_system_reply("Market: sold " .. order.name .. " for " .. order.price .. " :platinum:")
    return true, nil
end

-- Pauses while an actual mission is active (2026-09-28, same idea as
-- OpenTools Sync.pluto's 2026-09-25 change). http.request() is synchronous
-- and blocking, and this script's inventory.php fetch is a heavy ~300KB
-- call with a ~27% flake rate (multi-second retries) - landing mid-combat
-- it risks a stutter, for data (Owned counts) and actions (a buy/sell click
-- in the shop) that can wait until the mission ends. So while in a mission:
-- no inventory sync, no order handling (orders just stay queued on the
-- backend), and only a slow MISSION_HEARTBEAT_MS ping to the backend so
-- the launcher/web app still show the script as alive (status.pluto.
-- inMission) instead of "Disconnected". The moment the mission ends the
-- inventory is re-synced immediately, so loot shows up in "Owned" at once.
--
-- The check is `gGameRules instanceof LotusGameRules` - the attested
-- idiom (Complete Wave or Mission.pluto), and the one OpenTools settled on
-- after a first version that used `IsNull(gGameRules)` proved WRONG (it read
-- "in mission" in the orbiter, because gGameRules is a real non-null object
-- there too, just a different class). IsNull() stays as a cheap first guard
-- for the brief window gGameRules is unset during a region load. Known,
-- accepted side effect: the Simulacrum uses a different class, so it counts
-- as "not in a mission" and the script keeps running normally there.
-- OpenTools confirmed mission entry/exit, dojo, relay and Cetus hub
-- in-game; not tested there: Railjack, Duviri, open-world zones - and this
-- script's own pause/resume prints below are NOT yet confirmed in-game.
local MISSION_HEARTBEAT_MS = 10000 -- while paused for a mission: how often to tell the backend we're still alive

local function isInActiveMission()
    if IsNull(gGameRules) then
        return false
    end
    return gGameRules instanceof LotusGameRules
end

-- Tells the backend we're alive and in a mission. The backend answers 204
-- WITHOUT handing out an order (see routes.ts's /internal/pending-order),
-- so nothing is ever executed mid-mission.
local function sendMissionHeartbeat()
    pcall(function()
        return http.request(backendUrl("/internal/pending-order?inMission=1"), {
            method = "GET",
            dont_reuse = true,
            dont_make_reusable = true,
        })
    end)
end

local pausedForMission = false
local lastMissionHeartbeat = 0

print("Market Sync: started, polling " .. backendUrl("/internal/pending-order") .. " every " .. POLL_MS .. "ms")

local lastPoll = os.millis()
local nextInventoryAttempt = 0 -- 0 forces an immediate first attempt

repeat
    local now = os.millis()
    local inMission = isInActiveMission()

    if inMission then
        if not pausedForMission then
            print("Market Sync: active mission detected, pausing order handling and inventory sync until it ends")
            pausedForMission = true
            lastMissionHeartbeat = 0 -- heartbeat right away so the backend learns we're in a mission
        end
        if now - lastMissionHeartbeat >= MISSION_HEARTBEAT_MS then
            lastMissionHeartbeat = now
            sendMissionHeartbeat()
        end
    elseif pausedForMission then
        print("Market Sync: mission ended, resuming")
        pausedForMission = false
        nextInventoryAttempt = 0 -- refresh Owned right away (loot from the mission)
    end

    if not inMission and now >= nextInventoryAttempt then
        local succeeded = syncInventorySnapshot()
        nextInventoryAttempt = now + (succeeded and INVENTORY_POLL_MS or INVENTORY_RETRY_MS)
    end

    if not inMission and now - lastPoll >= POLL_MS then
        lastPoll = now

        local order = fetchPendingOrder()
        if order then
            print("Market Sync: processing " .. order.direction .. " order for " .. tostring(order.name) .. " (" .. tostring(order.gameRef) .. ") at " .. tostring(order.price) .. " platinum")

            local wasOk, detail
            if order.direction == "buy" then
                wasOk, detail = doBuy(order)
            elseif order.direction == "sell" then
                wasOk, detail = doSell(order)
            else
                wasOk, detail = false, "unknown order direction: " .. tostring(order.direction)
            end

            if not wasOk then
                print("Market Sync: order failed - " .. tostring(detail))
                chat_system_reply("Market: " .. order.direction .. " of " .. tostring(order.name) .. " failed - " .. tostring(detail))
            end

            reportResult(order.id, wasOk, detail)
        end
    end
until yield()

print("Market Sync: stopped.")
