{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMarket Launcher",
  "version": "1.0.1",
  "identifier": "com.embercatz.openmarket-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMarket Launcher",
        "width": 900,
        "height": 640,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwOTFDQzQwQTMyNTE0MApSV1JBVVRJS3hCd0pDNmJYRjRvU2ZkbGJqWlBtd1k3OHk0K2FrRGMzbmVpR0d0anZ4TkpCdFIyZQo=",
      "endpoints": [
        "https://github.com/EmberCatz/OpenMarket/releases/latest/download/latest.json"
      ]
    }
  }
}
